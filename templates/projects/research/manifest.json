{
  "id": "research",
  "version": "1.3.4",
  "owner_role_id": "lead",
  "name": "产品调研",
  "description": "可追溯来源、事实与推断分离、分析复核及报告验收。",
  "workflow": "{{ROLE_LEAD}}确认问题并建需求、拆解任务 → {{ROLE_RESEARCHER}}收集来源 → {{ROLE_ANALYST}}形成有证据的分析 → {{ROLE_VERIFIER}}核对来源与推断 → {{ROLE_LEAD}}验收报告并关闭任务和需求。",
  "roles": [
    {
      "id": "lead",
      "name": "调研负责人",
      "responsibilities": "明确调研问题和时间范围、建需求拆任务、协调成员、接收阻塞通知、验收报告并关闭任务和需求",
      "permissions": [
        "req.create",
        "req.update",
        "req.resume",
        "req.complete",
        "req.cancel",
        "task.create",
        "task.update",
        "task.resume",
        "task.complete",
        "task.cancel"
      ],
      "required": true,
      "soul_reference": "references/souls/lead.md"
    },
    {
      "id": "researcher",
      "name": "资料研究员",
      "responsibilities": "采集一手来源、记录发布日期与检索时间、标注证据局限",
      "permissions": [],
      "required": true,
      "soul_reference": "references/souls/researcher.md"
    },
    {
      "id": "analyst",
      "name": "分析员",
      "responsibilities": "关联证据与结论、区分事实和推断、形成可追溯报告",
      "permissions": [],
      "required": true,
      "soul_reference": "references/souls/analyst.md"
    },
    {
      "id": "verifier",
      "name": "复核员",
      "responsibilities": "独立核验来源、时间范围、覆盖和推断边界",
      "permissions": [],
      "required": true,
      "soul_reference": "references/souls/verifier.md"
    }
  ],
  "directory_modes": [
    "shared",
    "worktree"
  ],
  "files": [
    {
      "source": "AGENTS.md.tmpl",
      "target": "AGENTS.md"
    },
    {
      "source": "README.md.tmpl",
      "target": "README.md"
    },
    {
      "source": "files/docs/INDEX.md.tmpl",
      "target": "docs/INDEX.md"
    },
    {
      "source": "files/docs/BRIEF.md.tmpl",
      "target": "docs/BRIEF.md"
    },
    {
      "source": "files/materials/SOURCES.md.tmpl",
      "target": "materials/SOURCES.md"
    },
    {
      "source": "files/drafts/ANALYSIS.md.tmpl",
      "target": "drafts/ANALYSIS.md"
    },
    {
      "source": "files/outputs/REPORT.md.tmpl",
      "target": "outputs/REPORT.md"
    },
    {
      "source": "files/docs/CHECKLIST.md.tmpl",
      "target": "docs/CHECKLIST.md"
    }
  ]
}
